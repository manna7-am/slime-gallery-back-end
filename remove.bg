import requests
import tensorflow as tf
import numpy as np
from PIL import Image
import io

def remove_background_api(api_key, image_path, output_path):
    """Removes background using remove.bg API."""
    try:
        with open(image_path, "rb") as image_file:
            response = requests.post(
                "https://api.remove.bg/v1.0/removebg",
                files={"image_file": image_file},
                data={"size": "auto"},
                headers={"X-Api-Key": api_key},
            )

        if response.status_code == requests.codes.ok:
            with open(output_path, "wb") as output_file:
                output_file.write(response.content)
            print("Background removed successfully (API)!")
            return True
        else:
            print(f"Error (API): {response.status_code}, {response.text}")
            return False

    except Exception as e:
        print(f"An error occurred (API): {e}")
        return False

def remove_background_ml(model_path, image_path, output_path):
    """Removes background using a TensorFlow.js model."""
    try:
        model = tf.saved_model.load(model_path) #loads a saved model from a directory.
        #model = tf.keras.models.load_model(model_path) #loads a keras model from a .keras file.

        img = Image.open(image_path).convert("RGB")
        img = img.resize((257, 257))  # Resize to model input size
        img_array = np.array(img) / 255.0
        img_array = np.expand_dims(img_array, axis=0)
        img_tensor = tf.convert_to_tensor(img_array, dtype=tf.float32)

        # Assuming the model outputs a segmentation mask
        result = model(img_tensor)
        mask = result[0].numpy().squeeze() #remove batch dimension and squeeze.

        #Threshold the mask.
        mask = (mask > 0.5).astype(np.uint8) #example threshold.

        #resize mask to original size.
        original_img = Image.open(image_path).convert("RGB")
        mask_img = Image.fromarray(mask * 255).convert('L') #convert to grayscale image.
        mask_img = mask_img.resize(original_img.size, Image.NEAREST)
        mask = np.array(mask_img) / 255.0

        # Apply mask to original image
        original_array = np.array(original_img) / 255.0
        output_array = original_array * np.expand_dims(mask, axis=-1)

        output_image = Image.fromarray((output_array * 255).astype(np.uint8))
        output_image.save(output_path)
        print("Background removed successfully (ML)!")
        return True

    except Exception as e:
        print(f"An error occurred (ML): {e}")
        return False

# Example usage:
api_key = "j9GT3mLViD9pVDFBkx4L6jn6" #replace with your api key.
image_path = "input.jpg"
output_api_path = "output_api.png"
output_ml_path = "output_ml.png"
model_path = "path/to/your/saved_model" #replace with model path.

use_api = True #set to false to use ML.

if use_api:
    remove_background_api(api_key, image_path, output_api_path)
else:
    remove_background_ml(model_path, image_path, output_ml_path)
